# Keep project text files consistent across operating systems.
* text=auto eol=lf

# Windows command scripts require CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts must remain executable with LF line endings.
*.sh text eol=lf

# Binary assets must never be modified by line-ending conversion.
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.ttf binary

# Preserve vendored LibRaw snapshots byte-for-byte.
android/app/src/main/cpp/libraw/** -text
windows/native_lib/libraw/** -text
